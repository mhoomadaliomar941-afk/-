# Edge Function secrets. Set with:  supabase secrets set --env-file supabase/.env
# (copy this file to supabase/.env, which git ignores). Names only here, never values.
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are provided by Supabase automatically.

HYPERPAY_BASE_URL=            # sandbox https://eu-test.oppwa.com until replica-deploy
HYPERPAY_ACCESS_TOKEN=
HYPERPAY_ENTITY_ID_CARD=
HYPERPAY_ENTITY_ID_APPLEPAY=
HYPERPAY_WEBHOOK_KEY=         # hex key shown when you create the webhook in the HyperPay dashboard
CRON_SECRET=                  # any long random string; the same value goes into Vault as cron_secret
APP_RETURN_URL=nazih://topup
