    "build": "node scripts/build.mjs",
    "check": "npm run validate && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@minecraft/server": "2.10.0",
    "@minecraft/server-ui": "2.2.0",
    "typescript": "^5.6.0"
  }
}
