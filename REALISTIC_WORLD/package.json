{
  "name": "realistic-world",
  "version": "0.2.0",
  "private": true,
  "description": "REALISTIC WORLD - Ultimate Earth Simulation add-on for Minecraft Bedrock 1.26.52",
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --import ./tests/mocks/register.mjs --test tests/*.test.mjs",
