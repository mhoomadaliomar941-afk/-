<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The ScriptHookVDotNet v3 script. Core sources are compiled directly into
    this assembly so the mod ships as ONE dll with zero third-party
    dependencies (avoids assembly version conflicts in the GTA scripts folder).
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>OrganizationEmpire</RootNamespace>
    <AssemblyName>OrganizationEmpire</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>portable</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\OrganizationEmpire.Core\**\*.cs" Exclude="..\OrganizationEmpire.Core\obj\**;..\OrganizationEmpire.Core\bin\**" LinkBase="Core" />
    <EmbeddedResource Include="..\OrganizationEmpire.Core\Localization\ar.txt" LogicalName="OrganizationEmpire.ar.txt" />
  </ItemGroup>
  <ItemGroup>
    <!-- Reference only: ScriptHookVDotNet3.dll is provided by the SHVDN install, never shipped by this mod. -->
    <PackageReference Include="ScriptHookVDotNet3" Version="3.6.0" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Security" />
  </ItemGroup>
</Project>
